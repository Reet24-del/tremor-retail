# Backend (services/api)
# Optional: without these the app runs fully on deterministic fallbacks (cached/heuristic extraction, template text)
ANTHROPIC_API_KEY=
TREMOR_LLM_MODEL=           # a current Claude Sonnet model id from your Anthropic console
TREMOR_CORS_ORIGINS=http://localhost:3000
# TREMOR_EMBEDDINGS=1       # use sentence-transformers for semantic matching (pip install sentence-transformers)
# TREMOR_DISABLE_LLM=1      # force deterministic mode (used by tests)

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
